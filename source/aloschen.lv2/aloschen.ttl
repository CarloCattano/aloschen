@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#>.
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .

<http://ktano-studio.com/aloschen>
a lv2:Plugin, lv2:UtilityPlugin;
lv2:requiredFeature urid:map;
lv2:optionalFeature lv2:hardRTCapable;
doap:name "ALO";
doap:license <http://opensource.org/licenses/isc>;
doap:maintainer [
  doap:name "Carlo Cattano" ;
] ;
ui:ui <http://ktano-studio.com/aloschen#ui>;


lv2:minorVersion 3;
lv2:microVersion 0;

rdfs:comment """
ALO is a 3-slot, transport-synced live looper.

Per slot:
- Press Loop: arm; recording starts quantized (Bars-cycle downbeat for the very first loop, otherwise next loop boundary)
- Records/overdubs exactly one loop and auto-stops
- Press Undo: removes one overdub at the next bar; rapid presses clear the slot at the next bar

Controls:
- Bars: loop length in bars (host-synced)
- Click: metronome level (suppressed when any slot has audio)
- Mix: dry/loop balance
- Loop N Volume: per-slot playback gain (does not affect recording)
""";

lv2:port
[
	a lv2:AudioPort, lv2:InputPort;
	lv2:index 0;
	lv2:symbol "in_left";
	lv2:name "In_left"
],
[
	a lv2:AudioPort, lv2:InputPort;
	lv2:index 1;
	lv2:symbol "in_right";
	lv2:name "In_right"
],
[
	a lv2:AudioPort, lv2:OutputPort;
	lv2:index 2;
	lv2:symbol "out_left";
	lv2:name "Out_left"
],
[
	a lv2:AudioPort, lv2:OutputPort;
	lv2:index 3;
	lv2:symbol "out_right";
	lv2:name "Out_right"
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 4;
	lv2:symbol "loop1";
	lv2:name "Loop1";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
	lv2:portProperty lv2:integer, lv2:toggled;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 5;
	lv2:symbol "Undo1";
	lv2:name "Undo1";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
	lv2:portProperty lv2:integer, lv2:toggled;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 6;
	lv2:symbol "loop2";
	lv2:name "Loop2";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
	lv2:portProperty lv2:integer, lv2:toggled;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 7;
	lv2:symbol "Undo2";
	lv2:name "Undo2";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
	lv2:portProperty lv2:integer, lv2:toggled;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 8;
	lv2:symbol "loop3";
	lv2:name "Loop3";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
	lv2:portProperty lv2:integer, lv2:toggled;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 9;
	lv2:symbol "Undo3";
	lv2:name "Undo3";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
	lv2:portProperty lv2:integer, lv2:toggled;
],
[
	a atom:AtomPort, lv2:InputPort;
	atom:bufferType atom:Sequence;
	atom:supports midi:MidiEvent;
	lv2:index 10;
	lv2:symbol "midiin";
	lv2:name "MIDI In";
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 11;
	lv2:symbol "midi_base";
	lv2:name "MIDI Base";
	lv2:default 60;
	lv2:minimum 1;
	lv2:maximum 120;
	lv2:portProperty lv2:integer;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 12;
	lv2:symbol "click";
	lv2:name "Click";
	lv2:default 1;
	lv2:minimum 0;
	lv2:maximum 10;
	lv2:portProperty lv2:integer;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 13;
	lv2:symbol "bars";
	lv2:name "Bars";
	lv2:default 2;
	lv2:minimum 1;
	lv2:maximum 16;
	lv2:portProperty lv2:integer;
],
[
	a lv2:InputPort, atom:AtomPort ;
	atom:bufferType atom:Sequence ;
	atom:supports time:Position ;
	lv2:index 14;
	lv2:symbol "control" ;
	lv2:name "Control" ;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 15;
	lv2:symbol "mix";
	lv2:name "Mix";
	lv2:default 50;
	lv2:minimum 0;
	lv2:maximum 100;
	lv2:portProperty lv2:integer;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 16;
	lv2:symbol "ENABLED";
	lv2:name "ENABLED";
	lv2:default 1.0;
	lv2:minimum 0.0;
	lv2:maximum 1.0;
	lv2:designation lv2:enabled;
	lv2:portProperty lv2:toggled;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 17;
	lv2:symbol "loop1_state";
	lv2:name "Loop1 State";
	lv2:minimum 0;
	lv2:maximum 1;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 18;
	lv2:symbol "loop2_state";
	lv2:name "Loop2 State";
	lv2:minimum 0;
	lv2:maximum 1;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 19;
	lv2:symbol "loop3_state";
	lv2:name "Loop3 State";
	lv2:minimum 0;
	lv2:maximum 1;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 20;
	lv2:symbol "bar_step";
	lv2:name "Bar Step";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 63;
	lv2:portProperty lv2:integer;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 21;
	lv2:symbol "loop1_vol";
	lv2:name "Loop1 Volume";
	lv2:default 1.0;
	lv2:minimum 0;
	lv2:maximum 1.0;
	units:unit units:coef ;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 22;
	lv2:symbol "loop2_vol";
	lv2:name "Loop2 Volume";
	lv2:default 1.0;
	lv2:minimum 0;
	lv2:maximum 1.0;
	units:unit units:coef ;
],
[
	a lv2:ControlPort, lv2:InputPort;
	lv2:index 23;
	lv2:symbol "loop3_vol";
	lv2:name "Loop3 Volume";
	lv2:default 1.0;
	lv2:minimum 0;
	lv2:maximum 1.0;
	units:unit units:coef ;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 24;
	lv2:symbol "undo1_state";
	lv2:name "Undo1 State";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 25;
	lv2:symbol "undo2_state";
	lv2:name "Undo2 State";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 26;
	lv2:symbol "undo3_state";
	lv2:name "Undo3 State";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 27;
	lv2:symbol "loop1_has_audio";
	lv2:name "Loop1 Has Audio";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
	lv2:portProperty lv2:integer;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 28;
	lv2:symbol "loop2_has_audio";
	lv2:name "Loop2 Has Audio";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
	lv2:portProperty lv2:integer;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 29;
	lv2:symbol "loop3_has_audio";
	lv2:name "Loop3 Has Audio";
	lv2:default 0;
	lv2:minimum 0;
	lv2:maximum 1;
	lv2:portProperty lv2:integer;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 30;
	lv2:symbol "cycle_phase";
	lv2:name "Cycle Phase";
	lv2:default 0.0;
	lv2:minimum 0.0;
	lv2:maximum 1.0;
],
[
	a lv2:ControlPort, lv2:OutputPort;
	lv2:index 31;
	lv2:symbol "host_bar_phase";
	lv2:name "Host Bar Phase";
	lv2:default 0.0;
	lv2:minimum 0.0;
	lv2:maximum 1.0;
].


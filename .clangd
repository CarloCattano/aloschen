If:
  PathMatch: (source|tests|vst3)/.*\.(c|h)
CompileFlags:
  Add:
    - -xc
    - -std=gnu99
    - -DNDEBUG
---
If:
  PathMatch: (tests|vst3)/[^/]+\.(c|h)
CompileFlags:
  Add: [-I../source, -I../vst3]
---
# Paths are relative to vst3/ (clangd uses the file directory).
# C++ sources of the DPF VST3 wrapper (vst3/README.md).
If:
  PathMatch: vst3/.*\.(cpp|hpp)
CompileFlags:
  Remove: [-std=gnu99]
  Add:
    - -xc++
    - -std=gnu++17
    - -I.
    - -I../source
    - -I../deps/DPF/distrho
    - -I../deps/DPF/dgl
    - -DDISTRHO_NAMESPACE=DISTRHO

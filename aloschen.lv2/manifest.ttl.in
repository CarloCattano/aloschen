@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<http://ktano-studio.com/aloschen> a lv2:Plugin .
<http://ktano-studio.com/aloschen> lv2:binary <aloschen@LIB_EXT@> .
<http://ktano-studio.com/aloschen> rdfs:seeAlso <aloschen.ttl>, <modgui.ttl> .

# Native desktop UI
<http://ktano-studio.com/aloschen> ui:ui <http://ktano-studio.com/aloschen#ui> .

<http://ktano-studio.com/aloschen#ui>
	a ui:X11UI ;
	lv2:binary <aloschen_ui@LIB_EXT@> ;
	lv2:extensionData ui:idleInterface, ui:showInterface ;
	rdfs:seeAlso <aloschen.ttl> .

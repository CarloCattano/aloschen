@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://ktano-studio.com/aloschen>
    modgui:gui [
    modgui:resourcesDirectory <modgui> ;
    modgui:iconTemplate <modgui/icon-alo.html> ;
    modgui:stylesheet <modgui/stylesheet-alo.css> ;
    modgui:javascript <modgui/script-alo.js> ;
    modgui:screenshot <modgui/screenshot-alo.png> ;
    modgui:thumbnail <modgui/thumbnail-alo.png> ;
    modgui:brand "devcurmudgeon" ;
    modgui:label "ALOSCHEN" ;
    modgui:model "combo-model-001" ;
    modgui:panel "0600" ;
    modgui:monitoredOutputs [
        lv2:symbol "loop1_state" ;
    ] , [
        lv2:symbol "loop2_state" ;
    ] , [
        lv2:symbol "loop3_state" ;
    ] , [
        lv2:symbol "loop1_has_audio" ;
    ] , [
        lv2:symbol "loop2_has_audio" ;
    ] , [
        lv2:symbol "loop3_has_audio" ;
    ] , [
        lv2:symbol "undo1_state" ;
    ] , [
        lv2:symbol "undo2_state" ;
    ] , [
        lv2:symbol "undo3_state" ;
    ] , [
        lv2:symbol "bar_step" ;
    ] , [
        lv2:symbol "cycle_phase" ;
    ] , [
        lv2:symbol "host_bar_phase" ;
    ] ;
] .
